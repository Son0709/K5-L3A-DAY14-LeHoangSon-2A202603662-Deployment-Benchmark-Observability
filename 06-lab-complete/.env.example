# ============================================================
# Biến môi trường của agent. Dùng:  cp .env.example .env
# File .env đã nằm trong .gitignore — KHÔNG commit secret thật.
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security: đặt một chuỗi ngẫu nhiên dài, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me

# Redis (rate limit + cost guard). Trong docker compose giá trị này được đè thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request tối đa / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD): vượt ngưỡng nào trước thì trả 402
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
